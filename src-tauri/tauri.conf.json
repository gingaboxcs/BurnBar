{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BurnBar",
  "version": "0.1.2",
  "identifier": "com.ryan.burnbar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "BurnBar",
        "width": 480,
        "height": 600,
        "minWidth": 420,
        "minHeight": 420,
        "visible": true,
        "center": true,
        "focus": true,
        "resizable": true,
        "url": "index.html"
      },
      {
        "label": "bar",
        "title": "BurnBar",
        "width": 220,
        "height": 36,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "url": "bar.html"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1ODQxRDI2QzUyN0VFQjcKUldTMzdpZkZKaDJFdGFveUZFSXErU01CbEgzYkRLcU95UWJJQ2RaL25IV3J4Qlp1NlNibjRrWXoK",
      "endpoints": [
        "https://github.com/gingaboxcs/BurnBar/releases/latest/download/latest.json"
      ]
    }
  }
}
